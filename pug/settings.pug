    h1(translation_id="settings-language") Langue
    hr
    .settings-line(style="color: var(--text-color);")
      span("translation_id"="choose-language")
      select#selectLang(name="language")
        button
          selectedcontent
        option(value="de") 
          img(src="https://upload.wikimedia.org/wikipedia/commons/b/ba/Flag_of_Germany.svg")
          span Deutsch
        option(value="en")
          img(src="https://upload.wikimedia.org/wikipedia/commons/a/a5/Flag_of_the_United_Kingdom_(1-2).svg") 
          span English
        option(value="es") 
          img(src="https://upload.wikimedia.org/wikipedia/commons/2/24/Flag_of_the_Kingdom_of_Spain.svg")
          span Español
        option(value="eo") 
          img(src="https://upload.wikimedia.org/wikipedia/commons/f/f5/Flag_of_Esperanto.svg")
          span Esperanto
        option(value="fr") 
          img(src="https://upload.wikimedia.org/wikipedia/en/c/c3/Flag_of_France.svg")
          span Français  
        option(value="it")
          img(src="https://upload.wikimedia.org/wikipedia/en/0/03/Flag_of_Italy.svg") 
          span Italiano
        option(value="jp") 
          img(src="https://upload.wikimedia.org/wikipedia/en/9/9e/Flag_of_Japan.svg")
          span 日本語
        option(value="ko") 
          img(src="https://upload.wikimedia.org/wikipedia/commons/0/09/Flag_of_South_Korea.svg")
          span 한국어
